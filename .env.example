# OpenRouter credentials for CyberSec Terminal Agent
# Copy this file to .env and fill in the values.

OPENROUTER_API_KEY=

# Any OpenRouter model id, e.g. openai/gpt-4o-mini, anthropic/claude-3.5-sonnet
OPENROUTER_MODEL=

# Optional overrides
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_SECONDS=120
# OPENROUTER_MAX_RETRIES=3
